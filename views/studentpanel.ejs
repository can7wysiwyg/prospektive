<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">

    <title>Student Panel - Don Bosco</title>
    <style>
  :root {
    --school-navy: #1a2744;
    --school-gold: #c49a2a;
    --school-cream: #f7f5f0;
    --school-muted: #6b7280;
    --school-light: #eae8e2;
  }

  .student-panel {
    padding: 40px 0;
  }

  .welcome-box {
    background: linear-gradient(
      135deg,
      var(--school-navy),
      #24385f
    );
    color: white;
    padding: 35px;
    border-radius: 18px;
    margin-bottom: 35px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .welcome-box h2 {
    margin: 0;
    font-weight: 700;
  }

  .welcome-box p {
    margin-top: 10px;
    color: rgba(255,255,255,0.8);
  }

  .panel-card {
    background: white;
    border-radius: 18px;
    padding: 28px;
    border: 1px solid var(--school-light);
    box-shadow: 0 8px 22px rgba(0,0,0,0.05);
    transition: 0.3s ease;
    height: 100%;
  }

  .panel-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 35px rgba(0,0,0,0.1);
  }

  .panel-icon {
    width: 75px;
    height: 75px;
    border-radius: 18px;
    background: var(--school-navy);
    color: var(--school-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34px;
    margin-bottom: 20px;
  }

  .panel-card h4 {
    color: var(--school-navy);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .panel-card p {
    color: var(--school-muted);
    font-size: 15px;
    margin-bottom: 20px;
  }

  .panel-btn {
    background: var(--school-gold);
    color: white;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: 0.3s ease;
    font-weight: 600;
  }

  .panel-btn:hover {
    background: #ab8420;
    color: white;
  }
</style>

</head>
<body>
    <div id="navmenu"></div>

    <div id="stuPanelCon"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 <script src="/js/nav.js" defer></script>
   <script src="/js/auth.js" defer></script>
         <script src="/js/check.js" defer></script>

 <script src="/js/studentpanel.js" defer></script>

 
</body>
</html>