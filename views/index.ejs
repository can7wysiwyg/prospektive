<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">

    <title>Home - Don Bosco</title>
</head>
<body>
    <div id="navmenu"></div>


    <!-- HERO -->
<section class="hero">
  <div style="position:relative;z-index:1;max-width:600px;">
    
    <h1>Your <span>Academic Journey</span><br>Starts Here</h1>
    <p class="hero-sub">Access your courses, results, timetables, and school notices — all in one place. Built for students, staff, and parents.</p>
    <div class="hero-actions">
      <button class="btn-gold">View My Courses</button>
      <button class="btn-outline-light-custom">Check Results</button>
    </div>
  </div>
</section>

<!-- STATS STRIP -->
<div class="stats-strip">
  <div class="stat-item"><div class="stat-num">1,240</div><div class="stat-label">Enrolled Students</div></div>
  <div class="stat-item"><div class="stat-num">48</div><div class="stat-label">Active Courses</div></div>
  <div class="stat-item"><div class="stat-num">94%</div><div class="stat-label">Pass Rate 2024</div></div>
  <div class="stat-item"><div class="stat-num">87</div><div class="stat-label">Teaching Staff</div></div>
</div>

<!-- QUICK ACCESS -->
<section class="quick-section">
  <p class="section-label">Quick Access</p>
  <p class="section-title">What do you need today?</p>
  <div class="quick-grid">
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-books" aria-hidden="true"></i></div>
      <div class="quick-card-title">My Courses</div>
      <div class="quick-card-sub">6 enrolled</div>
    </a>
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-calendar-event" aria-hidden="true"></i></div>
      <div class="quick-card-title">Timetable</div>
      <div class="quick-card-sub">This week</div>
    </a>
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-clipboard-list" aria-hidden="true"></i></div>
      <div class="quick-card-title">Assignments</div>
      <div class="quick-card-sub">3 pending</div>
    </a>
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-chart-line" aria-hidden="true"></i></div>
      <div class="quick-card-title">My Results</div>
      <div class="quick-card-sub">Term 2</div>
    </a>
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-credit-card" aria-hidden="true"></i></div>
      <div class="quick-card-title">Fees & Payments</div>
      <div class="quick-card-sub">Balance due</div>
    </a>
    <a href="#" class="quick-card">
      <div class="quick-icon"><i class="ti ti-file-certificate" aria-hidden="true"></i></div>
      <div class="quick-card-title">Documents</div>
      <div class="quick-card-sub">Letters, IDs</div>
    </a>
  </div>
</section>

<!-- ANNOUNCEMENTS -->
<section class="announce-section">
  <p class="section-label">School Notices</p>
  <p class="section-title">Latest Announcements</p>
  <div class="announce-list">
    <div class="announce-item">
      <div class="announce-date"><div class="ann-day">02</div><div class="ann-mon">Jun</div></div>
      <div>
      </div>
      <span class="ann-tag tag-exam">Exam</span>
    </div>
    <div class="announce-item">
      <div class="announce-date"><div class="ann-day">30</div><div class="ann-mon">May</div></div>
      <div>
        <div class="ann-title">Inter-House Sports Day — Friday</div>
        <div class="ann-body">Annual sports day will be held on the school grounds. All students are expected to participate in house colours.</div>
      </div>
      <span class="ann-tag tag-event">Event</span>
    </div>
    <div class="announce-item">
      <div class="announce-date"><div class="ann-day">28</div><div class="ann-mon">May</div></div>
      <div>
        <div class="ann-title">Term 2 Fee Deadline Reminder</div>
        <div class="ann-body">All outstanding fees must be cleared by 6 June 2026 to avoid suspension from examinations.</div>
      </div>
      <span class="ann-tag tag-admin">Admin</span>
    </div>
  </div>
</section>

<!-- FOOTER STRIP -->
<div class="footer-strip">
  © 2026 <span>Don Bosco</span> · Student Portal · All rights reserved
</div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 <script src="/js/nav.js" defer></script>
  <script src="/js/check.js" defer></script>
  <script src="/js/auth.js" defer></script>


</body>
</html>