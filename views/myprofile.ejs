<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">

    <title>My Profile - Don Bosco</title>
    <style>
  :root {
    --school-navy: #1a2744;
    --school-gold: #c49a2a;
    --school-cream: #f7f5f0;
    --school-muted: #6b7280;
    --school-light: #eae8e2;
  }

  .profile-wrapper {
    padding: 40px 0;
  }

  .profile-card {
    background: white;
    border-radius: 18px;
    padding: 35px;
    border: 1px solid var(--school-light);
    box-shadow: 0 10px 25px rgba(0,0,0,0.06);
  }

  .avatar {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--school-navy);
    color: var(--school-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 38px;
    margin: 0 auto 20px;
  }

  .profile-title {
    text-align: center;
    color: var(--school-navy);
    font-weight: 700;
    margin-bottom: 30px;
  }

  .form-label {
    color: var(--school-navy);
    font-weight: 600;
  }

  .form-control {
    border-radius: 10px;
    border: 1px solid var(--school-light);
    padding: 12px 14px;
  }

  .form-control:focus {
    border-color: var(--school-gold);
    box-shadow: 0 0 0 3px rgba(196,154,42,0.15);
  }

  .update-btn {
    background: var(--school-gold);
    border: none;
    color: white;
    padding: 12px 25px;
    border-radius: 10px;
    font-weight: 600;
    width: 100%;
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

</head>
<body>
    <div id="navmenu"></div>

    <div id="uProfCon"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 <script src="/js/nav.js" defer></script>
  <script src="/js/check.js" defer></script>
  <script src="/js/auth.js" defer></script>
  <script src="/js/myprofile.js" defer></script>



</body>
</html>