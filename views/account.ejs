<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <title>Sign In - Don Bosco</title>
</head>
<body>
  <div class="signin-shell">
    <!-- Left panel: form -->
    <div class="signin-side">
      <div id="accouCon" style="width:100%;max-width:360px;"></div>
    </div>

    <!-- Right panel: branding -->
    <div class="signin-deco">
      <div class="signin-dots"></div>
      <div class="signin-deco-content">
        <div style="width:64px;height:64px;background:var(--gold);border-radius:16px;display:flex;align-items:center;justify-content:center;font-family:Georgia,serif;font-size:26px;font-weight:700;color:var(--navy);margin:0 auto 24px;">DB</div>
        <h2>Your <em>Academic</em><br>Life, Organised</h2>
        <p>Access your results, manage fees, track courses, and stay connected with your institution — all in one place.</p>
        <div style="display:flex;gap:18px;justify-content:center;margin-top:36px;">
          <div style="text-align:center;">
            <div style="font-size:24px;font-weight:700;color:var(--gold);font-family:var(--mono);">1,240</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">Students</div>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.1);"></div>
          <div style="text-align:center;">
            <div style="font-size:24px;font-weight:700;color:var(--gold);font-family:var(--mono);">48</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">Courses</div>
          </div>
          <div style="width:1px;background:rgba(255,255,255,0.1);"></div>
          <div style="text-align:center;">
            <div style="font-size:24px;font-weight:700;color:var(--gold);font-family:var(--mono);">94%</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px;">Pass Rate</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/account.js" defer></script>
</body>
</html>
