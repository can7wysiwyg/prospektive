    <title>My Fees - Don Bosco</title>
    <style>
  .fees-card {
    background: white;
    border-radius: 18px;
    padding: 25px;
    border: 1px solid #eae8e2;
    box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    max-width: 450px;
    margin: auto;
    text-align: center;
    margin-top: 10rem
  }

  .fees-status {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #1a2744;
  }

  .fees-msg {
    color: #6b7280;
    margin-bottom: 20px;
  }

  .btn-pay {
    background: #c49a2a;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.3s ease;
  }

  .btn-pay:hover {
    background: #ad861f;
  }

  .btn-disabled {
    background: #6b7280;
    cursor: not-allowed;
  }
</style>

</head>
<body>
    <div id="navmenu"></div>

      <div id="myFeesCon"></div>

